{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://banditbox.dev/schema/layout.schema.json",
  "title": "BanditBox layout document",
  "description": "Everything a profile shows on the TV. One per profile, plus optional per-device overrides. The web UI, backups, theme sharing and imports all read and write this format.",
  "type": "object",
  "required": ["schema", "profileId", "version", "profile", "rows"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": 1, "description": "Format version. Breaking changes bump this." },
    "profileId": { "$ref": "#/$defs/id", "description": "Stable profile id, for example p_kids." },
    "version": { "type": "integer", "minimum": 0, "description": "Increases with every change the server accepts." },
    "profile": { "$ref": "#/$defs/profile" },
    "theme": { "$ref": "#/$defs/theme" },
    "rows": { "type": "array", "items": { "$ref": "#/$defs/row" } },
    "folders": { "type": "array", "items": { "$ref": "#/$defs/folder" } },
    "hiddenApps": { "type": "array", "items": { "$ref": "#/$defs/packageName" }, "uniqueItems": true },
    "topBar": { "type": "array", "items": { "$ref": "#/$defs/topBarItem" } },
    "remap": { "type": "array", "items": { "$ref": "#/$defs/remap" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
    "packageName": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z0-9_]+)+$"
    },
    "itemRef": {
      "description": "An app package name, or folder:<id>.",
      "anyOf": [
        { "$ref": "#/$defs/packageName" },
        { "type": "string", "pattern": "^folder:[A-Za-z0-9_-]{1,64}$" }
      ]
    },
    "color": { "type": "string", "pattern": "^#([0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$" },
    "mediaRef": {
      "description": "Content-addressed media on the server: media:sha256-<hex>.",
      "type": "string",
      "pattern": "^media:sha256-[0-9a-f]{64}$"
    },
    "clockTime": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
    "profile": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 40 },
        "pin": { "type": ["string", "null"], "description": "Hash of the PIN, never the PIN itself. Null means no lock." },
        "autoLogin": { "type": "boolean", "default": false, "description": "Open this profile at boot without the picker." },
        "kids": { "$ref": "#/$defs/kids" }
      }
    },
    "kids": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "approvedApps": { "type": "array", "items": { "$ref": "#/$defs/packageName" }, "uniqueItems": true },
        "dailyLimitMin": { "type": ["integer", "null"], "minimum": 1, "maximum": 1440 },
        "bedtime": {
          "type": ["object", "null"],
          "required": ["start", "end"],
          "additionalProperties": false,
          "properties": {
            "start": { "$ref": "#/$defs/clockTime" },
            "end": { "$ref": "#/$defs/clockTime" }
          }
        }
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "accent": { "$ref": "#/$defs/color" },
        "wallpaper": { "anyOf": [{ "$ref": "#/$defs/mediaRef" }, { "type": "null" }] },
        "iconPack": { "type": ["string", "null"] },
        "screensaver": {
          "type": ["object", "null"],
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": { "type": "string", "enum": ["none", "system", "oled-drift"] }
          }
        }
      }
    },
    "tile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "size": { "type": "string", "enum": ["small", "medium", "large"], "default": "medium" },
        "style": { "type": "string", "enum": ["banner", "icon"], "default": "banner" },
        "shape": { "type": "string", "enum": ["rounded", "square", "circle"], "default": "rounded" }
      }
    },
    "row": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "type": "string", "enum": ["apps", "widget", "watchnext", "channel"] },
        "title": { "type": ["string", "null"], "maxLength": 60 }
      },
      "oneOf": [
        {
          "properties": {
            "id": true, "title": true,
            "type": { "const": "apps" },
            "tile": { "$ref": "#/$defs/tile" },
            "items": { "type": "array", "items": { "$ref": "#/$defs/itemRef" } }
          },
          "additionalProperties": false
        },
        {
          "required": ["feed"],
          "properties": {
            "id": true, "title": true,
            "type": { "const": "widget" },
            "feed": { "type": "string", "pattern": "^[a-z0-9_-]+(\\.[a-z0-9_-]+)+$", "description": "<plugin>.<feed>, for example bingebandit.continue-watching." }
          },
          "additionalProperties": false
        },
        {
          "description": "Continue watching: the Android TV Watch Next list that apps such as Plex, YouTube and Jellyfin publish.",
          "properties": {
            "id": true, "title": true,
            "type": { "const": "watchnext" },
            "kinds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "enum": ["continue", "next", "new", "watchlist"] },
              "default": ["continue", "next"],
              "description": "Which entries to show: continue (started), next (next episode), new (new episode or season), watchlist (saved for later)."
            },
            "apps": {
              "type": ["array", "null"],
              "items": { "$ref": "#/$defs/packageName" },
              "uniqueItems": true,
              "description": "Only entries from these apps. Null or missing means every app."
            },
            "limit": { "$ref": "#/$defs/contentLimit" },
            "size": { "$ref": "#/$defs/contentSize" }
          },
          "additionalProperties": false
        },
        {
          "description": "One app's preview channel: a row the app publishes for the Android TV home screen.",
          "required": ["package"],
          "properties": {
            "id": true, "title": true,
            "type": { "const": "channel" },
            "package": { "$ref": "#/$defs/packageName" },
            "channel": {
              "type": ["string", "null"],
              "minLength": 1,
              "maxLength": 100,
              "description": "The channel's name as the app publishes it, or its internal provider id. Null or missing means the app's first channel."
            },
            "limit": { "$ref": "#/$defs/contentLimit" },
            "size": { "$ref": "#/$defs/contentSize" }
          },
          "additionalProperties": false
        }
      ]
    },
    "contentLimit": { "type": "integer", "minimum": 1, "maximum": 50, "default": 20, "description": "The most cards a content row shows." },
    "contentSize": { "type": "string", "enum": ["small", "medium", "large"], "default": "medium", "description": "Card height on a content row." },
    "folder": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 40 },
        "items": { "type": "array", "items": { "$ref": "#/$defs/packageName" } }
      }
    },
    "topBarItem": {
      "description": "A built-in item (clock, inputs, network, settings, profile) or a widget feed id.",
      "type": "string",
      "pattern": "^(clock|inputs|network|settings|profile|[a-z0-9_-]+(\\.[a-z0-9_-]+)+)$"
    },
    "remap": {
      "type": "object",
      "required": ["key", "press", "action"],
      "additionalProperties": false,
      "properties": {
        "key": { "type": "string", "pattern": "^[A-Z0-9_]+$", "description": "Key name without the KEYCODE_ prefix, for example HOME or PROG_RED." },
        "press": { "type": "string", "enum": ["short", "long", "double"] },
        "action": { "$ref": "#/$defs/action" }
      }
    },
    "action": {
      "type": "object",
      "required": ["type"],
      "oneOf": [
        {
          "properties": { "type": { "const": "openApp" }, "package": { "$ref": "#/$defs/packageName" } },
          "required": ["package"],
          "additionalProperties": false
        },
        {
          "properties": { "type": { "const": "openInput" }, "input": { "type": "string", "minLength": 1 } },
          "required": ["input"],
          "additionalProperties": false
        },
        {
          "properties": { "type": { "enum": ["home", "allApps", "settings", "launcherSettings", "none"] } },
          "additionalProperties": false
        }
      ]
    }
  }
}
