{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://banditbox.dev/schema/layout.schema.json",
  "title": "BanditBox layout document",
  "description": "Everything a profile shows on the TV. One per profile, plus optional per-device overrides. The web UI, backups, theme sharing and imports all read and write this format.",
  "type": "object",
  "required": ["schema", "profileId", "version", "profile", "rows"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": 1, "description": "Format version. Breaking changes bump this." },
    "profileId": { "$ref": "#/$defs/id", "description": "Stable profile id, for example p_kids." },
    "version": { "type": "integer", "minimum": 0, "description": "Increases with every change the server accepts." },
    "profile": { "$ref": "#/$defs/profile" },
    "theme": { "$ref": "#/$defs/theme" },
    "rows": { "type": "array", "items": { "$ref": "#/$defs/row" } },
    "folders": { "type": "array", "items": { "$ref": "#/$defs/folder" } },
    "hiddenApps": { "type": "array", "items": { "$ref": "#/$defs/packageName" }, "uniqueItems": true },
    "topBar": { "type": "array", "items": { "$ref": "#/$defs/topBarItem" } },
    "remap": { "type": "array", "items": { "$ref": "#/$defs/remap" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
    "packageName": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z0-9_]+)+$"
    },
    "itemRef": {
      "description": "An app package name, or folder:<id>.",
      "anyOf": [
        { "$ref": "#/$defs/packageName" },
        { "type": "string", "pattern": "^folder:[A-Za-z0-9_-]{1,64}$" }
      ]
    },
    "color": { "type": "string", "pattern": "^#([0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$" },
    "mediaRef": {
      "description": "Content-addressed media on the server: media:sha256-<hex>.",
      "type": "string",
      "pattern": "^media:sha256-[0-9a-f]{64}$"
    },
    "packWallpaperRef": {
      "description": "A built-in wallpaper, pack:<pack>/<wallpaper>, as listed in themes.json.",
      "type": "string",
      "pattern": "^pack:[a-z0-9-]{1,32}/[a-z0-9-]{1,32}$"
    },
    "clockTime": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
    "profile": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 40 },
        "pin": { "type": ["string", "null"], "description": "Hash of the PIN, never the PIN itself. Null means no lock." },
        "autoLogin": { "type": "boolean", "default": false, "description": "Open this profile at boot without the picker." },
        "kids": { "$ref": "#/$defs/kids" }
      }
    },
    "kids": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "approvedApps": { "type": "array", "items": { "$ref": "#/$defs/packageName" }, "uniqueItems": true },
        "dailyLimitMin": { "type": ["integer", "null"], "minimum": 1, "maximum": 1440 },
        "bedtime": {
          "type": ["object", "null"],
          "required": ["start", "end"],
          "additionalProperties": false,
          "properties": {
            "start": { "$ref": "#/$defs/clockTime" },
            "end": { "$ref": "#/$defs/clockTime" }
          }
        }
      }
    },
    "theme": {
      "type": "object",
      "description": "How the profile looks. Every field is optional: a missing one takes the preset's value. themes.json lists the presets and wallpaper packs.",
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id", "description": "A preset from themes.json (nuclear, laser, dark, kids-dark, neon, cinematic, futuristic, or a variant such as neon-tokyo), or a custom theme's id. An unknown id draws the default preset with the fields below on top." },
        "accent": { "anyOf": [{ "$ref": "#/$defs/color" }, { "type": "null" }], "description": "Replaces the preset's accent color." },
        "adaptiveAccent": { "type": "boolean", "default": false, "description": "Take the accent from the wallpaper's colors. accent, or the preset's accent, is the fallback when the wallpaper has no strong color." },
        "colors": { "anyOf": [{ "$ref": "#/$defs/themeColors" }, { "type": "null" }] },
        "wallpaper": {
          "description": "An uploaded picture (media:sha256-<hex>), a pack wallpaper (pack:<pack>/<wallpaper>), or none for the plain background. Null or missing uses the preset's wallpaper.",
          "anyOf": [{ "$ref": "#/$defs/mediaRef" }, { "$ref": "#/$defs/packWallpaperRef" }, { "const": "none" }, { "type": "null" }]
        },
        "wallpaperDim": { "type": ["number", "null"], "minimum": 0, "maximum": 0.9, "description": "How much to darken the wallpaper so tiles stay readable; 0 is none. Null picks 0 for pack wallpapers and 0.45 for pictures." },
        "iconPack": {
          "description": "system draws each app's own icon. banditbox-uniform puts every icon on the same plate in the theme's colors; banditbox-mono also tints it with the accent. pkg:<package> uses an installed icon pack app (ADW/Nova format). Applies to icon tiles and to apps without a TV banner.",
          "anyOf": [
            { "type": "string", "pattern": "^(system|banditbox-uniform|banditbox-mono|pkg:[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z0-9_]+)+)$" },
            { "type": "null" }
          ]
        },
        "screensaver": {
          "type": ["object", "null"],
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": { "type": "string", "enum": ["none", "system", "oled-drift", "oled-starfield", "oled-black"], "description": "system leaves it to Android. The oled- types are drawn by the launcher on black with nothing held in place: oled-drift moves a dim clock every minute, oled-starfield is a slow star field, oled-black is plain black." },
            "timeoutMin": { "type": "integer", "minimum": 1, "maximum": 120, "default": 10, "description": "Minutes without a button press on the launcher before the screensaver starts." }
          }
        }
      }
    },
    "themeColors": {
      "type": "object",
      "description": "Overrides for the preset's colors, for custom themes made in the web UI.",
      "additionalProperties": false,
      "properties": {
        "background": { "$ref": "#/$defs/color" },
        "surface": { "$ref": "#/$defs/color" },
        "text": { "$ref": "#/$defs/color" }
      }
    },
    "tile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "size": { "type": "string", "enum": ["small", "medium", "large"], "default": "medium" },
        "style": { "type": "string", "enum": ["banner", "icon"], "default": "banner" },
        "shape": { "type": "string", "enum": ["rounded", "square", "circle"], "default": "rounded" }
      }
    },
    "row": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "type": "string", "enum": ["apps", "widget", "watchnext"] },
        "title": { "type": ["string", "null"], "maxLength": 60 }
      },
      "oneOf": [
        {
          "properties": {
            "id": true, "title": true,
            "type": { "const": "apps" },
            "tile": { "$ref": "#/$defs/tile" },
            "items": { "type": "array", "items": { "$ref": "#/$defs/itemRef" } }
          },
          "additionalProperties": false
        },
        {
          "required": ["feed"],
          "properties": {
            "id": true, "title": true,
            "type": { "const": "widget" },
            "feed": { "type": "string", "pattern": "^[a-z0-9_-]+(\\.[a-z0-9_-]+)+$", "description": "<plugin>.<feed>, for example bingebandit.continue-watching." }
          },
          "additionalProperties": false
        },
        {
          "properties": {
            "id": true, "title": true,
            "type": { "const": "watchnext" }
          },
          "additionalProperties": false
        }
      ]
    },
    "folder": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 40 },
        "items": { "type": "array", "items": { "$ref": "#/$defs/packageName" } }
      }
    },
    "topBarItem": {
      "description": "A built-in item (clock, inputs, network, settings, profile) or a widget feed id.",
      "type": "string",
      "pattern": "^(clock|inputs|network|settings|profile|[a-z0-9_-]+(\\.[a-z0-9_-]+)+)$"
    },
    "remap": {
      "type": "object",
      "required": ["key", "press", "action"],
      "additionalProperties": false,
      "properties": {
        "key": { "type": "string", "pattern": "^[A-Z0-9_]+$", "description": "Key name without the KEYCODE_ prefix, for example HOME or PROG_RED." },
        "press": { "type": "string", "enum": ["short", "long", "double"] },
        "action": { "$ref": "#/$defs/action" }
      }
    },
    "action": {
      "type": "object",
      "required": ["type"],
      "oneOf": [
        {
          "properties": { "type": { "const": "openApp" }, "package": { "$ref": "#/$defs/packageName" } },
          "required": ["package"],
          "additionalProperties": false
        },
        {
          "properties": { "type": { "const": "openInput" }, "input": { "type": "string", "minLength": 1 } },
          "required": ["input"],
          "additionalProperties": false
        },
        {
          "properties": { "type": { "enum": ["home", "allApps", "settings", "launcherSettings", "none"] } },
          "additionalProperties": false
        }
      ]
    }
  }
}
