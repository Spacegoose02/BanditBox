<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed to start the system uninstall dialog (a normal permission, granted at install). -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!--
        Android 11 package visibility: a launcher only needs to see apps it can launch,
        plus apps that offer a settings screen. No QUERY_ALL_PACKAGES.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.APPLICATION_PREFERENCES" />
        </intent>
        <!-- Icon pack apps (ADW / Nova / GO format), for the theme's icon pack choice. -->
        <intent>
            <action android:name="org.adw.launcher.THEMES" />
        </intent>
        <intent>
            <action android:name="com.novalauncher.THEME" />
        </intent>
        <intent>
            <action android:name="com.gau.go.launcherex.theme" />
        </intent>
    </queries>
</manifest>
