<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- To find the stock launchers' Home activities (Android 11 package visibility). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <application>
        <!--
            Optional. On Google TV (onn 4K) the stock launcher keeps the Home button even when
            another Home app is installed, so this service watches for its Home screen and opens
            BanditBox instead. Off until the user turns it on in Accessibility settings.
        -->
        <service
            android:name=".GuardService"
            android:exported="true"
            android:label="@string/guard_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/guard_service" />
        </service>
    </application>
</manifest>
